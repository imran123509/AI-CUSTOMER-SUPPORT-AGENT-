# ==============================================================================
# AI Agent — Environment Configuration
# Copy to .env and fill in real values. Never commit .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
APP_NAME=AI Agent
APP_ENV=development                  # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=AI Agent

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_PEPPER=change-me-too

# CORS — comma separated origins, or *
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_USER=unfyd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=unfyd_pivot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://unfyd:change-me@postgres:5432/unfyd_pivot
SYNC_DATABASE_URL=postgresql+psycopg://unfyd:change-me@postgres:5432/unfyd_pivot

# ------------------------------------------------------------------------------
# Redis (cache + short-term memory + Redis Streams queue)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_EVENTS=unfyd:events
REDIS_STREAM_DOCS=unfyd:docs
REDIS_STREAM_TICKETS=unfyd:tickets
REDIS_MEMORY_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# ChromaDB (vector store)
# ------------------------------------------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_HTTP_URL=http://chromadb:8000

# ------------------------------------------------------------------------------
# Gemini (Google AI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# RAG / File uploads
# ------------------------------------------------------------------------------
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=50
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,txt,csv,md
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180
RAG_TOP_K=5

# ------------------------------------------------------------------------------
# Tickets / SLA
# ------------------------------------------------------------------------------
SLA_DEFAULT_FIRST_RESPONSE_MINUTES=15
SLA_DEFAULT_RESOLUTION_HOURS=24

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=true
SENTRY_DSN=

# ------------------------------------------------------------------------------
# Feature flags
# ------------------------------------------------------------------------------
FEATURE_TRANSLATION=true
FEATURE_SENTIMENT=true
FEATURE_FAQ_GENERATION=true
FEATURE_SMART_REPLIES=true
